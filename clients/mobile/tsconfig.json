{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": [
      "react",
      "node"
    ],
    "paths": {
      "@resources/*": [
        "../../resources/js/*"
      ],
      "@native/*": [
        "../../resources/native/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "expo-env.d.ts"
  ]
}
